{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-ai",
  "main": "src/index-v2.ts",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
